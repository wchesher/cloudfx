#!/usr/bin/env bash
# Copyright (c) 2026 William Chesher. MIT License, see LICENSE.
# update-lumin8r - THE command for lumin8r on its box: converge code, runtime, service, edge and secrets, then prove it serves
{
set -euo pipefail

# One command per product, idempotent: a fresh box and a live box run the same thing, and a second run changes nothing.
# Every setting is an environment value (defaults below, overridable in /etc/lumin8r/update.env); secrets live only in
# /etc/lumin8r/lumin8r.env (0600, root) and are set with --set-key, never typed into a file in git.
#
# Usage: update-lumin8r                 # converge: sync, build a release, test it, voice agent, swap it in, service, edge, verify
#        update-lumin8r --check         # read-only: what is running, which release, does it answer
#        update-lumin8r --logs          # follow the service log
#        update-lumin8r --releases      # list releases, mark the live one
#        update-lumin8r --rollback      # swap back to the previous release and restart
#        update-lumin8r --set-key NAME  # read a secret from stdin into lumin8r.env (ANTHROPIC_API_KEY, MEFILE_JUDGE_MODEL,
#                                       #   OPENAI_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_AGENT_ID, LUMIN8R_TEAM_CODE)
#        update-lumin8r --down          # stop the service and take the site off the edge (data and releases kept)
#        update-lumin8r --auto-pull     # what the timer runs every minute: deploy when GitHub has a new commit, else nothing
#
# Settings in /etc/lumin8r/update.env handed to the service when set: MEFILE_VARIANTS, LUMIN8R_TEAM_NAME,
#   LUMIN8R_FINAL_VARIANT, LUMIN8R_WORKBENCH (1 turns on the hackathon workbench: /workbench, /paste, the team API;
#   off by default, and the product never links it), MEFILE_LLM_B_MODEL (LLM B's OpenAI model id exactly as OpenAI
#   lists it; with OPENAI_API_KEY set, LLM B runs by API instead of paste), MEFILE_LLM_B_EFFORT (default medium)
#
# Auto-pull: converge installs a systemd timer (lumin8r-autopull.timer) that runs --auto-pull every minute. It compares
#   the newest commit on GitHub with the live release and, only when they differ, runs the full converge (build, test
#   before swap, verify). A commit whose tests fail is recorded and skipped until a newer commit arrives, so a broken
#   push never loops and never replaces the live release. LUMIN8R_AUTO_PULL=0 in update.env removes the timer.
#   Watch it: journalctl -u lumin8r-autopull -f

SETTINGS_FILE="${LUMIN8R_SETTINGS:-/etc/lumin8r/update.env}"
# shellcheck disable=SC1090
[ -f "${SETTINGS_FILE}" ] && . "${SETTINGS_FILE}"

HOST_NAME="${LUMIN8R_HOST:-microverse.cloud}"
REPO_URL="${LUMIN8R_REPO:-https://github.com/wchesher/cloudfx}"
BRANCH="${LUMIN8R_BRANCH:-main}"
PORT="${LUMIN8R_PORT:-8097}"
BASE="${LUMIN8R_BASE:-/opt/lumin8r}"
DATA="${LUMIN8R_DATA:-/var/lib/lumin8r}"
ETC="${LUMIN8R_ETC:-/etc/lumin8r}"
SERVICE_USER="${LUMIN8R_USER:-lumin8r}"
UNIT="${LUMIN8R_UNIT:-/etc/systemd/system/lumin8r.service}"
CADDY_SITE="${LUMIN8R_CADDY_SITE:-/etc/caddy/conf.d/lumin8r.caddy}"
CADDY_RELOAD="${LUMIN8R_CADDY_RELOAD:-systemctl reload caddy}"
KEEP_RELEASES="${LUMIN8R_KEEP_RELEASES:-5}"
COMMAND_LINK="${LUMIN8R_COMMAND_LINK:-/usr/local/bin/update-lumin8r}"
PYTHON="${LUMIN8R_PYTHON:-python3}"
MEFILE_LLM_B_MODEL="${MEFILE_LLM_B_MODEL:-gpt-6.1-sol}"   # LLM B, "GPT Sol 6.1 Medium"; by API only when OPENAI_API_KEY is set
AUTO_PULL="${LUMIN8R_AUTO_PULL:-1}"
AUTO_PULL_INTERVAL="${LUMIN8R_AUTO_PULL_INTERVAL:-60}"
AUTO_PULL_UNIT="${LUMIN8R_AUTO_PULL_UNIT:-/etc/systemd/system/lumin8r-autopull}"
LOCK_FILE="${LUMIN8R_LOCK:-/run/lock/lumin8r-update.lock}"
SECRETS="${ETC}/lumin8r.env"
# The shared docker edge (teenyverse3 docs/architecture/shared-site-edge.md): when this box's ports belong to a Caddy
# running in docker with its admin API off (the sfhsbta edge on teenyverse.dev), lumin8r joins that edge as a TENANT:
# a container on the edge's network under an alias, and a site file in the directory the edge actually mounts.
EDGE_CONTAINER="${LUMIN8R_EDGE_CONTAINER:-teenyverse-sites-edge}"
EDGE_NETWORK="${LUMIN8R_EDGE_NETWORK:-${SITE_EDGE_NETWORK:-lariac-edge}}"
EDGE_HEALTH="${LUMIN8R_EDGE_HEALTH:-http://127.0.0.1:8081/healthz}"
APP_ALIAS="${LUMIN8R_ALIAS:-lumin8r-app}"
CONTAINER="${LUMIN8R_CONTAINER:-lumin8r}"
RUNTIME_IMAGE="${LUMIN8R_IMAGE:-lumin8r-runtime:py313}"
ALLOWED_KEYS="ANTHROPIC_API_KEY MEFILE_JUDGE_MODEL OPENAI_API_KEY ELEVENLABS_API_KEY ELEVENLABS_AGENT_ID LUMIN8R_TEAM_CODE"
# App settings that, when set in update.env, are handed to the service (the console at /admin shows them)
APP_SETTINGS="MEFILE_VARIANTS LUMIN8R_TEAM_NAME LUMIN8R_FINAL_VARIANT LUMIN8R_WORKBENCH MEFILE_LLM_B_MODEL MEFILE_LLM_B_EFFORT"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_B=$'\e[1m'; C_G=$'\e[32m'; C_R=$'\e[31m'; C_Y=$'\e[33m'; C_L=$'\e[38;5;154m'; C_O=$'\e[0m'
else
  C_B=""; C_G=""; C_R=""; C_Y=""; C_L=""; C_O=""
fi
STEP=0; TOTAL=9
step() { STEP=$((STEP + 1)); printf '%s[%d/%d]%s %s\n' "${C_L}" "${STEP}" "${TOTAL}" "${C_O}" "$1"; }
ok()   { printf '      %sok%s %s\n' "${C_G}" "${C_O}" "$1"; }
warn() { printf '      %swarn%s %s\n' "${C_Y}" "${C_O}" "$1"; }
die()  { printf '%supdate-lumin8r: %s%s\n' "${C_R}" "$1" "${C_O}" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "run as root (sudo update-lumin8r $*)"; }

live_release() { readlink -f "${BASE}/current" 2>/dev/null || true; }
release_name() { local live; live="$(live_release)"; printf '%s' "${live##*/}"; }

# The settings the service reads about itself, one NAME=value per line: the live release, the host, the port, and
# every APP_SETTINGS value set in update.env. Part of the container signature, so a change recreates the container.
app_env_lines() {
  printf 'LUMIN8R_RELEASE=%s\n' "$(release_name)"
  printf 'LUMIN8R_HOST=%s\n' "${HOST_NAME}"
  printf 'LUMIN8R_PORT=%s\n' "${PORT}"
  local name
  for name in ${APP_SETTINGS}; do
    if [ -n "${!name:-}" ]; then printf '%s=%s\n' "${name}" "${!name}"; fi
  done
}

# The same lines as systemd Environment= entries: quoted, with backslash, quote and the % specifier escaped
app_env_unit_lines() {
  local line
  while IFS= read -r line; do
    line="${line//\\/\\\\}"; line="${line//\"/\\\"}"; line="${line//%/%%}"
    printf 'Environment="%s"\n' "${line}"
  done < <(app_env_lines)
}

# docker when this box's edge is the shared docker edge, host otherwise (a plain systemd service behind a host Caddy)
edge_mode() {
  if command -v docker >/dev/null 2>&1 && docker inspect "${EDGE_CONTAINER}" >/dev/null 2>&1; then echo docker; else echo host; fi
}

edge_conf_dir() {
  docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/caddy/conf.d"}}{{.Source}}{{end}}{{end}}' "${EDGE_CONTAINER}" 2>/dev/null
}

# Apply a changed edge config the way update-sfhsbta does: validate offline (the edge runs with admin off, so there is
# no reload API), then restart the edge and wait for its health listener. Every site on the box blips for a moment.
edge_apply() {
  local out
  out="$(docker exec "${EDGE_CONTAINER}" caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1)" || { printf '%s\n' "${out}" | tail -15 >&2; return 1; }
  docker restart "${EDGE_CONTAINER}" >/dev/null
  local tries=0
  until curl -fsS --max-time 3 "${EDGE_HEALTH}" >/dev/null 2>&1; do
    tries=$((tries + 1)); [ "${tries}" -ge 30 ] && return 2
    sleep 1
  done
}

# (Re)create the lumin8r container when anything it was created from changed: the release, the secrets, the port,
# the network or the image. A container reads its env-file only when it is created, so a new key means a new container.
docker_run_service() {
  systemctl disable --now lumin8r >/dev/null 2>&1 || true
  docker network inspect "${EDGE_NETWORK}" >/dev/null 2>&1 \
    || die "the edge network ${EDGE_NETWORK} does not exist; docker inspect ${EDGE_CONTAINER} lists its networks, then set LUMIN8R_EDGE_NETWORK in ${SETTINGS_FILE}"
  if ! docker image inspect "${RUNTIME_IMAGE}" >/dev/null 2>&1; then
    printf 'FROM python:3.13-slim\nRUN pip install --no-cache-dir anthropic\nENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1\n' \
      | docker build -q -t "${RUNTIME_IMAGE}" - >/dev/null || die "could not build the runtime image ${RUNTIME_IMAGE}"
  fi
  local release secrets_sum image_id app_sum signature current line
  local -a app_env=()
  release="$(live_release)"
  secrets_sum="$(sha256sum "${SECRETS}" 2>/dev/null | cut -c1-16)"
  image_id="$(docker image inspect -f '{{.Id}}' "${RUNTIME_IMAGE}" | cut -c8-23)"
  while IFS= read -r line; do app_env+=(-e "${line}"); done < <(app_env_lines)
  app_sum="$(app_env_lines | sha256sum | cut -c1-16)"
  signature="${release}|${PORT}|${EDGE_NETWORK}|${APP_ALIAS}|${secrets_sum}|${image_id}|${app_sum}"
  current="$(docker inspect -f '{{index .Config.Labels "lumin8r.signature"}} {{.State.Running}}' "${CONTAINER}" 2>/dev/null || true)"
  if [ "${current}" = "${signature} true" ]; then return 0; fi
  docker rm -f "${CONTAINER}" >/dev/null 2>&1 || true
  docker run -d --name "${CONTAINER}" --restart unless-stopped \
    --label "lumin8r.signature=${signature}" \
    --network "${EDGE_NETWORK}" --network-alias "${APP_ALIAS}" \
    -p "127.0.0.1:${PORT}:8097" \
    --user "$(id -u "${SERVICE_USER}"):$(id -g "${SERVICE_USER}")" \
    --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges \
    -v "${release}:/app:ro" -v "${DATA}:/data" -w /data \
    --env-file "${SECRETS}" \
    -e PYTHONPATH=/app/src -e LUMIN8R_BIND=0.0.0.0 -e LUMIN8R_DATA=/data -e LUMIN8R_REQUIRE_TEAM_CODE=1 \
    -e MEFILE_CONSENT_DIR=/data/consent -e MEFILE_PEOPLE_DIR=/data/people \
    "${app_env[@]}" \
    "${RUNTIME_IMAGE}" python -m mefile serve --port 8097 >/dev/null \
    || die "could not start the ${CONTAINER} container"
}

verb_check() {
  printf '%slumin8r%s on %s\n' "${C_B}" "${C_O}" "${HOST_NAME}"
  local live; live="$(live_release)"
  printf '  release   %s\n' "${live:-none}"
  if [ "$(edge_mode)" = docker ]; then
    printf '  service   container %s: %s (behind the %s edge, alias %s)\n' "${CONTAINER}" \
      "$(docker inspect -f '{{.State.Status}}' "${CONTAINER}" 2>/dev/null || echo missing)" "${EDGE_CONTAINER}" "${APP_ALIAS}"
  else
    printf '  service   %s\n' "$(systemctl is-active lumin8r 2>/dev/null || echo unknown)"
  fi
  if curl -fsS --max-time 5 "http://127.0.0.1:${PORT}/api/config" >/dev/null 2>&1; then
    printf '  local     %sanswers%s on 127.0.0.1:%s\n' "${C_G}" "${C_O}" "${PORT}"
  else
    printf '  local     %sno answer%s on 127.0.0.1:%s\n' "${C_R}" "${C_O}" "${PORT}"
  fi
  if curl -fsS --max-time 8 "https://${HOST_NAME}/api/config" >/dev/null 2>&1; then
    printf '  public    %sanswers%s at https://%s\n' "${C_G}" "${C_O}" "${HOST_NAME}"
  else
    printf '  public    %sno answer%s at https://%s (DNS, edge or certificate)\n' "${C_Y}" "${C_O}" "${HOST_NAME}"
  fi
  if [ "${LUMIN8R_WORKBENCH:-}" = 1 ]; then
    printf '  %-20s on (/workbench, /paste, the team API)\n' LUMIN8R_WORKBENCH
  else
    printf '  %-20s off (LUMIN8R_WORKBENCH=1 in %s turns it on)\n' LUMIN8R_WORKBENCH "${SETTINGS_FILE}"
  fi
  local key
  for key in ${ALLOWED_KEYS}; do
    if [ -r "${SECRETS}" ] && grep -q "^${key}=." "${SECRETS}" 2>/dev/null; then printf '  %-20s set\n' "${key}"; else printf '  %-20s not set\n' "${key}"; fi
  done
  if [ -n "${MEFILE_LLM_B_MODEL:-}" ] && grep -q '^OPENAI_API_KEY=.' "${SECRETS}" 2>/dev/null; then
    printf '  %-20s by API: %s, effort %s\n' "LLM B" "${MEFILE_LLM_B_MODEL}" "${MEFILE_LLM_B_EFFORT:-medium}"
  else
    printf '  %-20s paste (by API needs OPENAI_API_KEY and MEFILE_LLM_B_MODEL in %s)\n' "LLM B" "${SETTINGS_FILE}"
  fi
}

# The --set-key mechanism: write NAME=value into lumin8r.env (0640 root:service), replacing any earlier line for NAME.
# The value is never printed. verb_set_key reads it from stdin; the converge's voice-agent step stores the agent id here.
write_secret() {
  local name="$1" value="$2"
  case " ${ALLOWED_KEYS} " in *" ${name} "*) ;; *) die "--set-key takes one of: ${ALLOWED_KEYS}" ;; esac
  [ -n "${value}" ] || die "empty value; nothing changed"
  install -d -m 0750 -o root -g "${SERVICE_USER}" "${ETC}" 2>/dev/null || install -d -m 0750 "${ETC}"
  local tmp; tmp="$(mktemp)"; chmod 0600 "${tmp}"
  [ -f "${SECRETS}" ] && grep -v "^${name}=" "${SECRETS}" > "${tmp}" || true
  printf '%s=%s\n' "${name}" "${value}" >> "${tmp}"
  install -m 0640 -o root -g "${SERVICE_USER}" "${tmp}" "${SECRETS}" 2>/dev/null || install -m 0600 "${tmp}" "${SECRETS}"
  rm -f "${tmp}"
}

# The value of one secret, for this script's own use (never printed)
secret_value() { [ -r "${SECRETS}" ] && sed -n "s/^$1=//p" "${SECRETS}" | tail -1 || true; }

verb_set_key() {
  need_root --set-key
  local name="${1:-}"
  case " ${ALLOWED_KEYS} " in *" ${name} "*) ;; *) die "--set-key takes one of: ${ALLOWED_KEYS}" ;; esac
  [ -t 0 ] && printf 'value for %s (input hidden, then Enter): ' "${name}" >&2
  local value; IFS= read -rs value || true; [ -t 0 ] && printf '\n' >&2
  write_secret "${name}" "${value}"
  if [ "$(edge_mode)" = docker ] && [ -e "${BASE}/current" ]; then
    docker_run_service
    ok "${name} saved to ${SECRETS}; the ${CONTAINER} container was recreated to read it"
  else
    systemctl try-restart lumin8r 2>/dev/null || true
    ok "${name} saved to ${SECRETS}; service restarted if it was running"
  fi
}

verb_releases() {
  local live; live="$(live_release)"
  ls -1dt "${BASE}"/releases/* 2>/dev/null | while read -r r; do
    if [ "$(readlink -f "$r")" = "${live}" ]; then printf '* %s (live)\n' "$(basename "$r")"; else printf '  %s\n' "$(basename "$r")"; fi
  done
}

verb_rollback() {
  need_root --rollback
  local live previous; live="$(live_release)"
  previous="$(ls -1dt "${BASE}"/releases/* 2>/dev/null | while read -r r; do [ "$(readlink -f "$r")" != "${live}" ] && { echo "$r"; break; }; done)"
  [ -n "${previous}" ] || die "no earlier release to roll back to"
  ln -sfn "${previous}" "${BASE}/current.next" && mv -Tf "${BASE}/current.next" "${BASE}/current"
  if [ "$(edge_mode)" = docker ]; then docker_run_service; else host_write_unit; systemctl restart lumin8r; fi
  ok "rolled back to $(basename "${previous}")"
}

verb_down() {
  need_root --down
  systemctl disable --now lumin8r-autopull.timer 2>/dev/null || true
  systemctl disable --now lumin8r 2>/dev/null || true
  if [ "$(edge_mode)" = docker ]; then
    docker rm -f "${CONTAINER}" >/dev/null 2>&1 || true
    local site; site="$(edge_conf_dir)/lumin8r.caddy"
    if [ -f "${site}" ]; then rm -f "${site}"; edge_apply || warn "the edge did not come back cleanly; check docker logs ${EDGE_CONTAINER}"; fi
  elif [ -f "${CADDY_SITE}" ]; then rm -f "${CADDY_SITE}"; ${CADDY_RELOAD} || warn "caddy reload failed; check the edge"; fi
  ok "lumin8r is down and auto-pull is off; releases in ${BASE} and data in ${DATA} are kept (update-lumin8r brings both back)"
}

render_unit() {
  cat <<UNIT_EOF
# written by update-lumin8r; change settings in ${SETTINGS_FILE}, secrets with update-lumin8r --set-key
[Unit]
Description=lumin8r (Your Personality, Your File)
After=network-online.target
Wants=network-online.target

[Service]
User=${SERVICE_USER}
Group=${SERVICE_USER}
WorkingDirectory=${DATA}
EnvironmentFile=-${SECRETS}
Environment=PYTHONPATH=${BASE}/current/src
Environment=MEFILE_CONSENT_DIR=${DATA}/consent
Environment=MEFILE_PEOPLE_DIR=${DATA}/people
Environment=LUMIN8R_DATA=${DATA}
Environment=LUMIN8R_REQUIRE_TEAM_CODE=1
Environment=PYTHONUNBUFFERED=1
$(app_env_unit_lines)
ExecStart=${BASE}/current/.venv/bin/python -m mefile serve --port ${PORT}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=${DATA}
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
UNIT_EOF
}

# Write the systemd unit when it changed (it names the live release, so a release or a rollback rewrites it);
# UNIT_CHANGED=1 tells the caller to restart, so a changed setting reaches the running service
UNIT_CHANGED=0
# SECRETS_CHANGED=1: the converge wrote a secret (the voice agent id), so the service must restart to read it
SECRETS_CHANGED=0
host_write_unit() {
  local unit_new; unit_new="$(mktemp)"; render_unit > "${unit_new}"
  if ! cmp -s "${unit_new}" "${UNIT}" 2>/dev/null; then install -m 0644 "${unit_new}" "${UNIT}"; systemctl daemon-reload; UNIT_CHANGED=1; fi
  rm -f "${unit_new}"
}

render_site() {
  cat <<SITE_EOF
# written by update-lumin8r; the hostname is LUMIN8R_HOST in ${SETTINGS_FILE}
${HOST_NAME} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}
	reverse_proxy ${UPSTREAM:-127.0.0.1:${PORT}}
}

www.${HOST_NAME} {
	redir https://${HOST_NAME}{uri} permanent
}
SITE_EOF
}

verb_converge() {
  need_root
  # one update at a time: a manual run and the auto-pull timer never overlap
  mkdir -p "$(dirname "${LOCK_FILE}")"
  exec 9>"${LOCK_FILE}"
  flock -n 9 || die "another update is running (lock ${LOCK_FILE}); try again in a minute"
  local tools
  step "preflight"
  for tools in git curl systemctl "${PYTHON}"; do command -v "${tools}" >/dev/null 2>&1 || die "missing ${tools}"; done
  "${PYTHON}" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' || die "${PYTHON} must be 3.11 or newer"
  "${PYTHON}" -c 'import venv' 2>/dev/null || die "${PYTHON} has no venv module (apt install python3-venv)"
  ok "tools present, $(${PYTHON} --version 2>&1)"

  step "user, folders, secrets file"
  id -u "${SERVICE_USER}" >/dev/null 2>&1 || useradd --system --home "${DATA}" --shell /usr/sbin/nologin "${SERVICE_USER}"
  install -d -m 0755 "${BASE}" "${BASE}/releases"
  install -d -m 0700 -o "${SERVICE_USER}" -g "${SERVICE_USER}" "${DATA}" "${DATA}/consent" "${DATA}/people" "${DATA}/experiment" "${DATA}/team" "${DATA}/final" "${DATA}/shares"
  install -d -m 0750 -o root -g "${SERVICE_USER}" "${ETC}"
  [ -f "${SECRETS}" ] || install -m 0640 -o root -g "${SERVICE_USER}" /dev/null "${SECRETS}"
  ok "${DATA} (0700, ${SERVICE_USER}), ${SECRETS} (0640)"

  step "sync ${REPO_URL} ${BRANCH}"
  local cache="${BASE}/repo"
  if [ -d "${cache}/.git" ]; then
    git -C "${cache}" fetch --depth 50 origin "${BRANCH}" -q
    git -C "${cache}" reset --hard -q "origin/${BRANCH}"
  else
    git clone -q --depth 50 --branch "${BRANCH}" "${REPO_URL}" "${cache}"
  fi
  local revision; revision="$(git -C "${cache}" rev-parse --short HEAD)"
  ok "at ${revision}: $(git -C "${cache}" log -1 --format=%s | cut -c1-70)"
  if [ -z "${LUMIN8R_REEXEC:-}" ] && ! cmp -s "${cache}/deploy/update-lumin8r" "$(readlink -f "$0")"; then
    ok "update-lumin8r itself changed in ${revision}; continuing with the new copy"
    LUMIN8R_REEXEC=1 exec bash "${cache}/deploy/update-lumin8r"
  fi

  step "build release ${revision}"
  local release="${BASE}/releases/${revision}"
  if [ ! -x "${release}/.venv/bin/python" ]; then
    rm -rf "${release}.building"
    git -C "${cache}" archive --format=tar HEAD | (mkdir -p "${release}.building" && tar -x -C "${release}.building")
    "${PYTHON}" -m venv "${release}.building/.venv"
    "${release}.building/.venv/bin/pip" install -q --upgrade pip >/dev/null
    "${release}.building/.venv/bin/pip" install -q anthropic pytest >/dev/null
    rm -rf "${release}"; mv "${release}.building" "${release}"
    ok "built ${release}"
  else
    ok "already built"
  fi

  step "test the release before it goes live"
  if (cd "${release}" && PYTHONPATH=src .venv/bin/python -m pytest -q -p no:cacheprovider >/tmp/lumin8r-tests.log 2>&1); then
    ok "$(tail -1 /tmp/lumin8r-tests.log)"
  else
    tail -20 /tmp/lumin8r-tests.log >&2
    die "tests failed on ${revision}; the live release is unchanged ($(basename "$(live_release)" 2>/dev/null || echo none))"
  fi

  # The ElevenLabs interview agent, from the release's own voice.py (prompt, disclosure, recording off, auth on).
  # API key set, no agent id: create the agent and store its id (the --set-key mechanism). Both set: update it in
  # place. A failure warns and never blocks the deploy: the app refuses voice sessions until the agent passes its check.
  step "voice agent (ElevenLabs)"
  local voice_key; voice_key="$(secret_value ELEVENLABS_API_KEY)"
  if [ -z "${voice_key}" ]; then
    ok "skipped: no ELEVENLABS_API_KEY (sudo update-lumin8r --set-key ELEVENLABS_API_KEY turns the voice interview on)"
  else
    local voice_agent voice_out voice_log; voice_agent="$(secret_value ELEVENLABS_AGENT_ID)"; voice_log="$(mktemp)"
    if voice_out="$(cd "${release}" && ELEVENLABS_API_KEY="${voice_key}" ELEVENLABS_AGENT_ID="${voice_agent}" \
          PYTHONPATH=src .venv/bin/python -m mefile voice-agent 2>"${voice_log}" | tail -1)" \
        && [[ "${voice_out}" =~ ^[A-Za-z0-9_-]+$ ]]; then
      if [ "${voice_out}" != "${voice_agent}" ]; then
        write_secret ELEVENLABS_AGENT_ID "${voice_out}"; SECRETS_CHANGED=1
        ok "agent ${voice_out} created and stored as ELEVENLABS_AGENT_ID; recording off and auth on, checked"
      else
        ok "agent ${voice_agent} updated; recording off and auth on, checked"
      fi
    else
      warn "voice agent not provisioned ($(tail -1 "${voice_log}")); voice sessions are refused until it passes"
    fi
    rm -f "${voice_log}"
  fi
  unset voice_key

  step "swap in and run the service"
  local before; before="$(live_release)"
  ln -sfn "${release}" "${BASE}/current.next" && mv -Tf "${BASE}/current.next" "${BASE}/current"
  local mode; mode="$(edge_mode)"
  if [ "${mode}" = docker ]; then
    docker_run_service
  else
    host_write_unit
    systemctl enable -q lumin8r
    if [ "${before}" != "$(live_release)" ] || [ "${UNIT_CHANGED}" = 1 ] || [ "${SECRETS_CHANGED}" = 1 ] || ! systemctl is-active -q lumin8r; then systemctl restart lumin8r; fi
  fi
  local tries=0
  until curl -fsS --max-time 3 "http://127.0.0.1:${PORT}/api/config" >/dev/null 2>&1; do
    tries=$((tries + 1)); [ "${tries}" -ge 20 ] && { if [ "${mode}" = docker ]; then docker logs --tail 30 "${CONTAINER}" >&2 || true; else journalctl -u lumin8r -n 30 --no-pager >&2 || true; fi; die "service did not answer on 127.0.0.1:${PORT}"; }
    sleep 1
  done
  ok "live: ${revision} on 127.0.0.1:${PORT} ($( [ "${mode}" = docker ] && echo "container ${CONTAINER}, alias ${APP_ALIAS} on ${EDGE_NETWORK}" || echo "systemd unit lumin8r"))"
  ln -sfn "${BASE}/current/deploy/update-lumin8r" "${COMMAND_LINK}"
  ls -1dt "${BASE}"/releases/* 2>/dev/null | tail -n +"$((KEEP_RELEASES + 1))" | while read -r old; do
    [ "$(readlink -f "${old}")" = "$(live_release)" ] || rm -rf "${old}"
  done

  step "edge: ${HOST_NAME}"
  if [ "${mode}" = docker ]; then
    local conf_dir; conf_dir="$(edge_conf_dir)"
    [ -n "${conf_dir}" ] && [ -d "${conf_dir}" ] || die "could not find the directory ${EDGE_CONTAINER} mounts at /etc/caddy/conf.d"
    local site="${conf_dir}/lumin8r.caddy" site_new; site_new="$(mktemp)"
    UPSTREAM="${APP_ALIAS}:8097" render_site > "${site_new}"
    if cmp -s "${site_new}" "${site}" 2>/dev/null; then
      ok "site unchanged in ${site}"
    else
      local previous_site=""; [ -f "${site}" ] && previous_site="$(cat "${site}")"
      install -m 0644 "${site_new}" "${site}"
      if edge_apply; then
        ok "site written to ${site}; the shared edge restarted cleanly (every site on this box blipped for a moment)"
      else
        if [ -n "${previous_site}" ]; then printf '%s\n' "${previous_site}" > "${site}"; else rm -f "${site}"; fi
        die "the edge refused the new site or did not come back; the site file was reverted. docker logs ${EDGE_CONTAINER}"
      fi
    fi
    rm -f "${site_new}"
  else
    if [ -d "$(dirname "${CADDY_SITE}")" ]; then
      local site_new; site_new="$(mktemp)"; render_site > "${site_new}"
      if ! cmp -s "${site_new}" "${CADDY_SITE}" 2>/dev/null; then
        install -m 0644 "${site_new}" "${CADDY_SITE}"
        if command -v caddy >/dev/null 2>&1 && [ -f /etc/caddy/Caddyfile ]; then caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1 || warn "caddy validate failed; check ${CADDY_SITE}"; fi
        ${CADDY_RELOAD} || warn "edge reload failed (${CADDY_RELOAD}); set LUMIN8R_CADDY_RELOAD"
        ok "site written to ${CADDY_SITE} and the edge reloaded"
      else
        ok "site unchanged"
      fi
      rm -f "${site_new}"
    else
      warn "no $(dirname "${CADDY_SITE}"); set LUMIN8R_CADDY_SITE to the edge's site folder. The site block it would write:"
      render_site | sed 's/^/        /'
    fi

  fi

  step "verify"
  if curl -fsS --max-time 10 "https://${HOST_NAME}/api/config" >/dev/null 2>&1; then
    ok "https://${HOST_NAME} answers"
  else
    warn "https://${HOST_NAME} does not answer yet: point its DNS A record at this box, then run update-lumin8r --check"
  fi
  if ! grep -q '^LUMIN8R_TEAM_CODE=.' "${SECRETS}" 2>/dev/null; then warn "no LUMIN8R_TEAM_CODE: /admin (and the workbench, when on) answers 503 until it is set (update-lumin8r --set-key LUMIN8R_TEAM_CODE)"; fi
  if ! grep -q '^ANTHROPIC_API_KEY=.' "${SECRETS}" 2>/dev/null; then warn "no ANTHROPIC_API_KEY: your understudy and the judge stay off (update-lumin8r --set-key ANTHROPIC_API_KEY)"; fi
  auto_pull_converge
  printf '%slumin8r%s %s is live. --check reads it, --logs follows it, --rollback undoes it.\n' "${C_B}" "${C_O}" "${revision}"
}

# The auto-pull timer: installed (or removed) by converge, idempotently.
render_auto_pull_service() {
  cat <<UNIT
[Unit]
Description=lumin8r auto-pull: deploy new commits from ${REPO_URL} ${BRANCH}
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=NO_COLOR=1
ExecStart=${COMMAND_LINK} --auto-pull
UNIT
}

render_auto_pull_timer() {
  cat <<UNIT
[Unit]
Description=lumin8r auto-pull every ${AUTO_PULL_INTERVAL}s

[Timer]
OnBootSec=120
OnUnitInactiveSec=${AUTO_PULL_INTERVAL}
AccuracySec=5
Persistent=false

[Install]
WantedBy=timers.target
UNIT
}

auto_pull_converge() {
  if [ "${AUTO_PULL}" = 0 ]; then
    if [ -f "${AUTO_PULL_UNIT}.timer" ]; then
      systemctl disable --now lumin8r-autopull.timer >/dev/null 2>&1 || true
      rm -f "${AUTO_PULL_UNIT}.timer" "${AUTO_PULL_UNIT}.service"; systemctl daemon-reload
      ok "auto-pull removed (LUMIN8R_AUTO_PULL=0)"
    fi
    return 0
  fi
  local changed=0 file_new
  file_new="$(mktemp)"; render_auto_pull_service > "${file_new}"
  cmp -s "${file_new}" "${AUTO_PULL_UNIT}.service" 2>/dev/null || { install -m 0644 "${file_new}" "${AUTO_PULL_UNIT}.service"; changed=1; }
  render_auto_pull_timer > "${file_new}"
  cmp -s "${file_new}" "${AUTO_PULL_UNIT}.timer" 2>/dev/null || { install -m 0644 "${file_new}" "${AUTO_PULL_UNIT}.timer"; changed=1; }
  rm -f "${file_new}"
  [ "${changed}" = 1 ] && systemctl daemon-reload
  systemctl enable -q --now lumin8r-autopull.timer
  [ "${changed}" = 1 ] && systemctl restart lumin8r-autopull.timer
  ok "auto-pull on: every ${AUTO_PULL_INTERVAL}s, new commits on ${BRANCH} deploy themselves (journalctl -u lumin8r-autopull -f)"
}

verb_auto_pull() {
  need_root
  local failed_file="${ETC}/auto-pull.failed" remote live
  remote="$(timeout 20 git ls-remote "${REPO_URL}" "refs/heads/${BRANCH}" 2>/dev/null | cut -f1)"
  [ -n "${remote}" ] || { echo "auto-pull: could not reach ${REPO_URL}; will try again"; exit 0; }
  live="$(release_name)"
  if [ -n "${live}" ] && [ "${remote#"${live}"}" != "${remote}" ]; then exit 0; fi   # live release is that commit
  if [ -f "${failed_file}" ] && [ "$(cat "${failed_file}")" = "${remote}" ]; then exit 0; fi   # already failed; wait for a newer push
  # skip quietly when a manual update holds the lock; the next tick picks it up
  mkdir -p "$(dirname "${LOCK_FILE}")"
  if ! ( exec 9>"${LOCK_FILE}"; flock -n 9 ); then echo "auto-pull: an update is running; next tick"; exit 0; fi
  echo "auto-pull: GitHub ${BRANCH} is ${remote:0:12}, live is ${live:-none}; deploying"
  if "${COMMAND_LINK}"; then
    rm -f "${failed_file}"
    echo "auto-pull: deployed ${remote:0:12}"
  else
    printf '%s' "${remote}" > "${failed_file}"
    echo "auto-pull: ${remote:0:12} did not deploy (the live release is unchanged); skipping it until a newer commit"
    exit 1
  fi
}

case "${1:-}" in
  "") verb_converge ;;
  --check) verb_check ;;
  --logs) if [ "$(edge_mode)" = docker ]; then exec docker logs -f "${CONTAINER}"; else exec journalctl -u lumin8r -f; fi ;;
  --releases) verb_releases ;;
  --rollback) verb_rollback ;;
  --set-key) verb_set_key "${2:-}" ;;
  --down) verb_down ;;
  --auto-pull) verb_auto_pull ;;
  --render) printf '%s\n\n' "--- ${UNIT}"; render_unit; printf '\n%s\n\n' "--- ${CADDY_SITE}"; render_site ;;
  -h|--help) sed -n '/^# Usage:/,/^$/p' "$0" | sed -e 's/^# \{0,1\}//'; exit 0 ;;
  *) printf 'update-lumin8r: unknown argument %s (try --help)\n' "$1" >&2; exit 2 ;;
esac
exit 0
}
